# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Used by docker-compose.ai-support.yml, scripts/preflight-check.* and the live (-Pit) tests.

# --- Postgres + pgvector (Blueprints 02, 03, 04, 07) ---
POSTGRES_USER=springai
POSTGRES_PASSWORD=
POSTGRES_DB=ai_enterprise_db
PG_HOST_PORT=5432
# The live tests read the libpq-style variables below
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_enterprise_db
PGUSER=springai
PGPASSWORD=

# --- Other backing services (host ports) ---
PRESIDIO_HOST_PORT=5002
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
REDIS_HOST_PORT=6379
GRAFANA_HOST_PORT=3000
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
OLLAMA_HOST_PORT=11434

# --- Local models (Ollama) ---
BLUEPRINTS_MODEL=stub
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# Space-separated list checked by the preflight script (8 GB RAM: keep to llama3.2:3b + nomic-embed-text)
REQUIRED_MODELS="llama3.2 qwen2.5-coder:7b nomic-embed-text"

# --- Optional cloud providers (not needed: every blueprint runs offline or on Ollama) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_AI_TOKEN=
AI_DASHSCOPE_API_KEY=
AZURE_OPENAI_API_KEY=

# --- Blueprint 06 local JWT secret (32+ random characters, local dev only) ---
BLUEPRINTS_DEV_JWT_SECRET=

# --- Optional observability export (Grafana otel-lgtm) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
