<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.aaron-samuvel</groupId>
    <artifactId>java-ai-blueprints</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>blueprint-01-goap-finops-incident-agent</artifactId>
  <name>blueprint-01-goap-finops-incident-agent</name>
  <description>GOAP planner + OODA loop FinOps incident agent (Embabel-style, self-contained).</description>
  <properties>
    <spring-boot.run.skip>false</spring-boot.run.skip>
    <spring-shell.version>4.0.3</spring-shell.version>
  </properties>
  <dependencies>
    <dependency><groupId>io.github.aaron-samuvel</groupId><artifactId>shared</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-client-chat</artifactId></dependency>
    <!-- interactive CLI: only active with the "shell" profile -->
    <dependency><groupId>org.springframework.shell</groupId><artifactId>spring-shell-starter</artifactId><version>${spring-shell.version}</version></dependency>
    <dependency><groupId>org.springframework.shell</groupId><artifactId>spring-shell-jline</artifactId><version>${spring-shell.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
    </plugins>
  </build>
</project>
